---
interface Props {
  index: number;
  id: string;
}

const { index, id } = Astro.props;
---

<h2 class="heading mono" id={`${id}-heading`}>
  <span class="index">{String(index).padStart(2, '0')}</span>
  <span class="label"><slot /></span>
</h2>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .index {
    color: var(--accent);
  }

  .heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  @media print {
    .heading {
      margin-bottom: 0.75rem;
    }
  }
</style>
