---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';
import { getCvManifest, getProfile, getProfilePhoto } from '../utils/content';
import { rich } from '../utils/rich';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const cv = getCvManifest();

const photo = await getProfilePhoto();

const contacts = [
  ...(profile.email ? [{ label: t('label.email'), url: `mailto:${profile.email}`, text: profile.email }] : []),
  ...profile.links.map((link) => ({
    label: link.label,
    url: link.url,
    text: link.cvLabel ?? link.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
  })),
];
---

<aside class="sidebar">
  <div class="identity">
    {
      photo ? (
        <Image class="avatar" src={photo} alt={`${t('profile.photo')} ${profile.name}`} width={256} height={256} />
      ) : (
        <span class="avatar monogram" aria-hidden="true">
          {profile.name[0]}
        </span>
      )
    }
    <h1>{profile.name}</h1>
    <p class="role">{profile.role[locale]}</p>
    <p class="location mono muted">{profile.location[locale]}</p>
  </div>

  <p class="bio muted" set:html={rich(profile.bio[locale])} />

  {
    profile.highlight && (
      <a class="highlight" href={profile.highlight.href}>
        {profile.highlight.text[locale]}
      </a>
    )
  }

  {
    cv && (
      <div class="cv no-print">
        <a class="button" href={withBase(`cv/${cv.pdf}`)} download>
          {t('cta.cv')} <span class="mono">PDF</span>
        </a>
        <a class="view" href={getRelativeLocaleUrl(locale, 'cv')}>
          {t('cta.cvView')} →
        </a>
      </div>
    )
  }

  <dl class="contacts">
    {
      contacts.map((c) => (
        <div>
          <dt class="mono">{c.label}</dt>
          <dd>
            <a href={c.url} rel={c.url.startsWith('mailto:') ? undefined : 'me'}>
              {c.text}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>

</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 2.5rem 3rem;
  }

  .avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .monogram {
    display: grid;
    place-items: center;
    border: 1px solid var(--rule);
    color: var(--accent);
    font-size: 2.5rem;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .role {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .location {
    margin-top: 0.25rem;
  }

  .bio {
    max-width: 30rem;
  }

  .bio :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  /* The one thing to notice first: set apart with the accent rule, like the research entry. */
  .highlight {
    max-width: 30rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .contacts div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    align-items: baseline;
    gap: 0.75rem;
  }

  dt {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
  }

  dd {
    min-width: 0;
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .cv {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .button .mono {
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  .button:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .view {
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .view:hover {
    color: var(--accent);
  }

  /* Desktop: the profile stays in view below the nav bar while the content scrolls. */
  @media (min-width: 64rem) {
    .sidebar {
      position: sticky;
      top: var(--header-height);
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      padding-block: 3rem 2rem;
    }
  }

  @media print {
    .sidebar {
      gap: 0.5rem;
      padding-block: 0 1rem;
    }

    .avatar,
    .highlight {
      display: none;
    }

    .contacts {
      padding-top: 0.5rem;
    }
  }
</style>
