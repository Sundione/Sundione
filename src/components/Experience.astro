---
import { getCollection } from 'astro:content';
import Entry from './Entry.astro';
import SectionHeading from './SectionHeading.astro';
import TagLine from './TagLine.astro';
import { formatMonth, sectionNumber, useTranslations, type Locale } from '../i18n/ui';
import { rich } from '../utils/rich';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const jobs = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));
const period = (start: string, end?: string) =>
  `${formatMonth(start, locale)} – ${end ? formatMonth(end, locale) : t('experience.present')}`;
---

<section id="experience" aria-labelledby="experience-heading">
  <SectionHeading index={sectionNumber('experience')} id="experience">{t('nav.experience')}</SectionHeading>
  <ol class="list">
    {
      jobs.map(({ id, data }) => (
        <li id={id}>
          <Entry date={period(data.start, data.end)}>
            {data.collaboration && (
              <p class="collab-row">
                {data.collaboration.url ? (
                  <a class="collab" href={data.collaboration.url}>
                    <span class="spark" aria-hidden="true">✦</span>
                    {data.collaboration.text[locale]} ↗
                  </a>
                ) : (
                  <span class="collab">
                    <span class="spark" aria-hidden="true">✦</span>
                    {data.collaboration.text[locale]}
                  </span>
                )}
              </p>
            )}
            <h3>
              {data.role[locale]}{' '}
              <span class="secondary">
                · {data.companyUrl ? <a href={data.companyUrl}>{data.company}</a> : data.company}
              </span>
            </h3>
            <p class="summary" set:html={rich(data.summary[locale])} />
            <TagLine locale={locale} skills={data.skills} tools={data.tools} />
            {data.links.length > 0 && (
              <p class="links mono no-print">
                {data.links.map((link) => (
                  <a href={link.url}>{link.label} ↗</a>
                ))}
              </p>
            )}
          </Entry>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collab-row {
    margin-bottom: 0.625rem;
  }

  /* A collaboration (e.g. with Google Research) is the strongest signal on the page: a filled accent badge. */
  .collab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.875rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  a.collab:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .spark {
    font-size: 0.75rem;
  }

  .secondary a {
    color: inherit;
    text-decoration-color: var(--rule);
  }

  .summary {
    margin-top: 0.375rem;
    color: var(--muted);
  }

  .summary :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }

  @media print {
    .list {
      gap: 1rem;
    }
  }
</style>
