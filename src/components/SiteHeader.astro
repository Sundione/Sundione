---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { sections, useTranslations, type Locale } from '../i18n/ui';
import { getProfile } from '../utils/content';

interface Props {
  locale: Locale;
  /** The current page path without the locale prefix ('' for home, 'cv' for the CV page). */
  path?: string;
}

const { locale, path = '' } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const home = getRelativeLocaleUrl(locale);
const cvUrl = getRelativeLocaleUrl(locale, 'cv');
---

<header class="site-header no-print">
  <div class="bar">
    <a class="brand" href={home}>{profile.name}</a>
    <nav class="sections" aria-label={t('nav.label')}>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`${home}#${s.id}`} data-section={s.id}>
                {t(s.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="actions">
      <a class="cv" href={cvUrl} aria-current={path === 'cv' ? 'page' : undefined}>CV</a>
      <LanguageSwitch locale={locale} path={path} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<script>
  // On the home page, highlight the nav link of the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.site-header [data-section]')].map((a) => [
      a.dataset.section!,
      a,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute('aria-current');
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'brand actions'
      'sections sections';
    align-items: center;
    column-gap: 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.625rem 1rem 0;
  }

  .brand {
    grid-area: brand;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .sections {
    grid-area: sections;
    /* On narrow screens the links scroll sideways instead of wrapping. */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sections ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0.5rem 0 0.625rem;
    list-style: none;
  }

  .sections a {
    position: relative;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .sections a:hover,
  .sections a[aria-current] {
    color: var(--text);
  }

  .sections a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.65rem;
    height: 2px;
    background: var(--accent);
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .cv {
    padding: 0.25rem 0.875rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cv:hover,
  .cv[aria-current='page'] {
    background: var(--accent);
    color: var(--bg);
  }

  @media (min-width: 52rem) {
    .actions {
      gap: 1rem;
    }

    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand sections actions';
      min-height: var(--header-height);
      padding: 0 2rem;
    }

    .sections ul {
      justify-content: center;
      padding: 0;
    }

    .sections a[aria-current]::after {
      bottom: -1.2rem;
    }
  }

  @media (min-width: 64rem) {
    .bar {
      padding-inline: 3rem;
    }
  }
</style>
