---
import SectionHeading from './SectionHeading.astro';
import { sectionNumber, useTranslations, type Locale } from '../i18n/ui';
import { getProfile } from '../utils/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
---

<section id="contact" class="no-print" aria-labelledby="contact-heading">
  <SectionHeading index={sectionNumber('contact')} id="contact">{t('nav.contact')}</SectionHeading>
  <p class="body">{t('contact.body')}</p>
  {profile.email && <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>}
  <ul class="links mono">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url}>{link.label} ↗</a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .body {
    max-width: 32rem;
  }

  .email {
    display: inline-block;
    margin-top: 1rem;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 500;
    text-decoration-color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
