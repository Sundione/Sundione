---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import Sidebar from './Sidebar.astro';
import Experience from './Experience.astro';
import Publications from './Publications.astro';
import Education from './Education.astro';
import Awards from './Awards.astro';
import Contact from './Contact.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';
import { getProfile, getShareImage } from '../utils/content';
import { plain } from '../utils/rich';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const description = `${profile.name} — ${plain(profile.bio[locale])}`;

// Structured data (schema.org Person) so search engines can tie the name, photo and profiles together.
const experience = await getCollection('experience');
const education = await getCollection('education');
const image = await getShareImage(Astro.site!);
const organization = (name: string, url?: string) => ({ '@type': 'Organization', name, ...(url && { url }) });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${profile.website}#person`,
  name: profile.name,
  url: profile.website,
  jobTitle: profile.role.en,
  description: plain(profile.bio[locale]),
  ...(image && { image: image.url }),
  ...(profile.email && { email: `mailto:${profile.email}` }),
  worksFor: experience
    .filter(({ data }) => !data.end && data.companyUrl)
    .map(({ data }) => organization(data.company, data.companyUrl)),
  affiliation: education.filter(({ data }) => !data.end).map(({ data }) => organization(data.institution)),
  alumniOf: education.filter(({ data }) => data.end).map(({ data }) => organization(data.institution)),
  sameAs: [...profile.links.map((l) => l.url), ...profile.sameAs],
};
// `<` is escaped so the JSON can never close the script tag.
const jsonLd = JSON.stringify(person).replace(/</g, '\\u003c');
---

<Base locale={locale} title={`${profile.name} — ${profile.headline[locale]}`} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <SiteHeader locale={locale} />
  <div class="page">
    <Sidebar locale={locale} />
    <main>
      <Experience locale={locale} />
      <Publications locale={locale} />
      <Education locale={locale} />
      <Awards locale={locale} />
      <Contact locale={locale} />
      <footer class="footer mono muted no-print">
        © {new Date().getFullYear()} {profile.name} · {t('footer.built')}
      </footer>
    </main>
  </div>
</Base>

<style>
  .page {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    max-width: var(--reading-width);
    padding-bottom: 3rem;
  }

  .footer {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 40rem) {
    .page {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .page {
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      gap: 5rem;
      padding-inline: 3rem;
    }

    main {
      padding-block: 4rem 5rem;
    }
  }

  @media print {
    .page {
      display: block;
      max-width: none;
      padding: 0;
    }

    main {
      gap: 1.5rem;
      max-width: none;
      padding: 0;
    }
  }
</style>
