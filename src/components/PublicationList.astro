---
import { getCollection } from 'astro:content';
import Entry from './Entry.astro';
import { formatMonth, type Locale } from '../i18n/ui';
import { getProfile } from '../utils/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = await getProfile();
const publications = (await getCollection('publications')).sort((a, b) => b.data.date.localeCompare(a.data.date));

// Same labels as the CV (scripts/cv.mjs).
const link = (p: { doi?: string; arxiv?: string }) =>
  p.doi
    ? { url: `https://doi.org/${p.doi}`, label: `doi:${p.doi}` }
    : { url: `https://arxiv.org/abs/${p.arxiv}`, label: `arXiv:${p.arxiv}` };
---

<ol class="list">
  {
    publications.map(({ data }) => {
      const { url, label } = link(data);
      return (
        <li>
          <Entry date={formatMonth(data.date, locale)}>
            <h3>
              <a href={url}>{data.title}</a>
            </h3>
            <p class="authors muted">
              {data.authors.map((author, i) => (
                <>
                  {i > 0 && ', '}
                  {author === profile.name ? <strong>{author}</strong> : author}
                </>
              ))}
            </p>
            <p class="source">
              <span class="venue">{data.venue}</span>
              <a class="mono" href={url}>
                {label} ↗
              </a>
            </p>
          </Entry>
        </li>
      );
    })
  }
</ol>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  h3 a {
    text-decoration: none;
  }

  .authors {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }

  .authors strong {
    color: var(--text);
    font-weight: 500;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }

  .venue {
    font-style: italic;
  }

  .source a {
    color: var(--muted);
  }
</style>
