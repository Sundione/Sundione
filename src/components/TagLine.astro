---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  skills: string[];
  tools: string[];
}

const { locale, skills, tools } = Astro.props;
const t = useTranslations(locale);
const rows = [
  { label: t('label.skills'), items: skills },
  { label: t('label.tools'), items: tools },
].filter((row) => row.items.length > 0);
---

{
  rows.length > 0 && (
    <dl class="tagline">
      {rows.map((row) => (
        <div>
          <dt class="mono">{row.label}</dt>
          <dd>{row.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .tagline {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.875rem 0 0;
    font-size: 0.9375rem;
  }

  .tagline div {
    display: flex;
    gap: 0.75rem;
  }

  dt {
    flex: none;
    width: 4.5rem;
    padding-top: 0.15rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }
</style>
